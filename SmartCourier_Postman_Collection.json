						"body": { "mode": "raw", "raw": "{\n  \"fullName\": \"John Doe\",\n  \"phone\": \"9876543210\",\n  \"street\": \"123 Main St\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"zipCode\": \"400001\",\n  \"country\": \"India\"\n}" },
						"url": { "raw": "{{baseUrl}}/gateway/deliveries/{{deliveryId}}/sender", "host": ["{{baseUrl}}"], "path": ["gateway", "deliveries", "{{deliveryId}}", "sender"] }
