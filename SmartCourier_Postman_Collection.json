						"body": { "mode": "raw", "raw": "{\n  \"weight\": 2.5,\n  \"length\": 30,\n  \"width\": 20,\n  \"height\": 15,\n  \"description\": \"Electronics\",\n  \"serviceType\": \"EXPRESS\",\n  \"declaredValue\": 75000,\n  \"fragile\": true\n}" },
