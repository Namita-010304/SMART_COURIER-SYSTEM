						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Jane Smith\",\n  \"phone\": \"9123456780\",\n  \"street\": \"456 Park Ave\",\n  \"city\": \"Delhi\",\n  \"state\": \"Delhi\",\n  \"zipCode\": \"110001\",\n  \"country\": \"India\"\n}" },
						"url": { "raw": "{{baseUrl}}/gateway/deliveries/{{deliveryId}}/receiver", "host": ["{{baseUrl}}"], "path": ["gateway", "deliveries", "{{deliveryId}}", "receiver"] }
